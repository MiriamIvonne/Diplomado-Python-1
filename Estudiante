#Ejercicio 2.
def obtener_precio(inventario, producto):
    precio = inventario.get(producto)
    if precio is not None:
        return f"El precio del {producto} es {precio}"
    else:
        return f"El producto {producto} no se encuentra en el inventario."

precios = {"manzana":15.5,"pila":25.0,"cuaderno":45.0}
print(obtener_precio(precios, "manzana"))
print(obtener_precio(precios, "lapiz"))

#Ejercicio 3.
def contar_caracteres(texto):
    contador = {}
    for letra in texto:
        if letra in contador:
            contador[letra] += 1
        else:
            contador[letra] = 1
    return contador

resultado = contar_caracteres ("programación")
print(resultado)

#Ejercicio 4.
def filtrar_aprobados(calificaciones, notamin):
    aprobados = {}
    for alumno,calif in calificaciones.items():
        if calif >= notamin:
            aprobados[alumno] = calif
    return aprobados

grupo = { "Ana":8.5,"Carlos":5.0,"Sofia":9.0,"Ivonne":7.0}
